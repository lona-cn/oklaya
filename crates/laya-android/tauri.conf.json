{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laya Mobile",
  "version": "0.1.0",
  "identifier": "dev.laya.mobile",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Laya", "width": 1200, "height": 850 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
